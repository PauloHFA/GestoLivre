{
  "name": "@gestolivre/bridge",
  "version": "0.1.0",
  "description": "Servidor de ponte WebSocket local para injeção de teclas e mouse no sistema operacional",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "gestolivre-bridge": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm,cjs --dts",
    "start": "node dist/cli.js",
    "dev": "tsup src/index.ts src/cli.ts --watch --onSuccess \"node dist/cli.js\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.14",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
